# Copy this file to ".env" (same folder) and fill it in. Never upload ".env" anywhere public.

# The password the owner types on the /admin/ page. Use something long that only the owner knows.
ADMIN_PASSWORD=change-this-password

# Port the website runs on (your hosting may set this for you)
PORT=3000

# Time zone used to decide what "today" is (so rooms free up at the right midnight)
TIMEZONE=Asia/Kolkata

# Set to true once the site is on https:// (recommended), so the login cookie is only sent securely
COOKIE_SECURE=false

# Set to true if the site sits behind a proxy/host that forwards the visitor's real address (Render, Railway, nginx...)
TRUST_PROXY=false

# --- Email alerts to the owner (optional) ---
# Leave RESEND_API_KEY empty to switch alerts off. Get a key at resend.com.
RESEND_API_KEY=
# The address that receives the alerts. With Resend's free test sender this MUST be the email you signed up to Resend with.
ADMIN_EMAIL=
# Only change this after you have verified your own domain in Resend, e.g. Farmstay Website <alerts@yourdomain.com>
MAIL_FROM=Farmstay Website <onboarding@resend.dev>

# --- Where bookings are stored (optional) ---
# Defaults to the "data" folder next to server.js. On a host with a persistent disk, point this at the disk, e.g. /var/data
# DATA_DIR=/var/data
